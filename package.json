{
  "name": "noras-lsl-fp",
  "publisher": "Nora",
  "displayName": "Noras LSL-FP",
  "description": "Support for Linden Scripting Language(LSL) with Firestorm Preprocessor and Code Snippeis",
  "version": "1.10.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/se-nora/vscode-lsl-fp-Nora.git"
	},
  "engines": {
    "vscode": "^1.81.0"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noras-lsl-fp.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "noras-lsl-fp.showFirestormBridgeOutput",
        "title": "Show Firestorm Bridge Output"
      }
    ],
    "languages": [
      {
        "id": "lsl",
        "aliases": [
          "LSL",
          "lsl"
        ],
        "extensions": [
          ".lsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lsl",
        "scopeName": "source.lsl",
        "path": "./syntaxes/lsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lsl",
        "path": "./snippets/lsl-functions.json"
      },
      {
        "language": "lsl",
        "path": "./snippets/constants.json"
      },
      {
        "language": "lsl",
        "path": "./snippets/event-handlers.json"
      },
      {
        "language": "lsl",
        "path": "./snippets/language-constructs.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "create-vsix": "npx @vscode/vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "~8.55.0",
    "@typescript-eslint/parser": "~8.55.0",
    "eslint": "^9.39.5",
    "fast-glob": "^3.3.3",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "@vscode/test-electron": "^2.5.2"
  }
}

